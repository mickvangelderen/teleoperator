// Draft protocol version 1. See README.md for framing and semantic validation.
// Append table fields and union members; never change existing wire values.
// All server timestamps are signed 64-bit nanoseconds in server-monotonic.
// Geometry uses fixed right-handed +X right, +Y up, -Z forward coordinates.
namespace XrOperator.Wire;

enum Hand:ubyte { None = 0, Left = 1, Right = 2 }
enum InputType:ubyte { Boolean = 0, Scalar = 1, Vector2 = 2 }
enum Requirement:ubyte { Omit = 0, Required = 1, Optional = 2 }
enum BooleanMode:ubyte { Runtime = 0, Hysteresis = 1 }
enum TargetTimePolicy:ubyte {
  AcquisitionTime = 0,
  PredictedDisplayTime = 1,
  AcquisitionOffset = 2
}
enum Fidelity:ubyte { Default = 0, Low = 1, High = 2 }
enum CalibrationStatus:ubyte { Unknown = 0, Valid = 1, Calibrating = 2, Invalid = 3 }
enum ReferenceSpaceKind:ubyte {
  View = 0, Local = 1, Stage = 2, LocalFloor = 3, Unbounded = 4
}
enum RejectionCode:ubyte {
  InvalidRequest = 0,
  UnsupportedCapability = 1,
  UnsupportedSetting = 2,
  PermissionDenied = 3,
  ResourceLimit = 4,
  UnknownStream = 5
}
enum CloseReason:ubyte {
  Unsubscribed = 0, CapabilityLost = 1, ServerStopped = 2
}
enum LocationFlags:ushort (bit_flags) {
  OrientationValid = 0,
  PositionValid = 1,
  OrientationTracked = 2,
  PositionTracked = 3
}
enum VelocityFlags:ubyte (bit_flags) { LinearValid = 0, AngularValid = 1 }

struct SessionId { low:ulong; high:ulong; }
struct MetadataRef { id:ulong; version:uint; }
struct Vec2 { x:float; y:float; }
struct Vec3 { x:float; y:float; z:float; }
struct Quaternion { x:float; y:float; z:float; w:float; }
struct Transform { position:Vec3; orientation:Quaternion; }
struct JointPose { transform:Transform; flags:LocationFlags; }

// A hysteresis rule names an analog input on the same source. Runtime mode
// uses the prepared Boolean action and leaves the other fields absent.
table BooleanRule {
  mode:BooleanMode = Runtime;
  analog_input_id:string;
  press_threshold:float = null;
  release_threshold:float = null;
}

table InputDefinition {
  source_id:string (required);
  input_id:string (required);
  hand:Hand = None;
  value_type:InputType;
  meaning:string (required);
  unit:string (required);
  minimum:Vec2;
  maximum:Vec2;
  device_label:string;
  boolean_rules:[BooleanRule];
}

table ControllerSource {
  source_id:string (required);
  hand:Hand = None;
  interaction_profile:string;
  restrictions:[string];
}

table PoseSource {
  source_id:string (required);
  meaning:string (required);
  supports_activity:bool;
  supports_velocities:bool;
  restrictions:[string];
}

table BodySource {
  source_id:string (required);
  joint_sets:[string] (required);
  fidelities:[Fidelity] (required);
  supports_actual_fidelity:bool;
  supports_calibration_status:bool;
  restrictions:[string];
}

table TargetTime {
  policy:TargetTimePolicy = AcquisitionTime;
  offset_ns:long;
}

// Settings tables are reused for requests and resolved descriptors. Null means
// advertised default in a request; descriptors must contain resolved settings.
table ControlSelection {
  source_id:string (required);
  input_id:string (required);
  requirement:Requirement = Required;
  boolean_rule:BooleanRule;
}

table ControllerSettings {
  sample_rate_hz:float = null;
  inputs:[ControlSelection] (required);
}

table PoseSelection {
  source_id:string (required);
  requirement:Requirement = Required;
  velocities:Requirement = Omit;
}

table PoseSettings {
  sample_rate_hz:float = null;
  sources:[PoseSelection] (required);
  base_space_id:ulong = null;
  target_time:TargetTime;
}

table BodySettings {
  sample_rate_hz:float = null;
  source_id:string (required);
  joint_set:string;
  base_space_id:ulong = null;
  target_time:TargetTime;
  fidelity_preference:Fidelity = null;
  actual_fidelity:Requirement = Omit;
  calibration_status:Requirement = Omit;
}

union Acquisition {
  ControllerSettings = 1,
  PoseSettings = 2,
  BodySettings = 3
}

table PublicationSettings {
  send_rate_hz:float = null;
  history_length:uint = 1;
}

table ControllerCapabilities {
  sources:[ControllerSource] (required);
  inputs:[InputDefinition] (required);
  sample_rates_hz:[float] (required);
  defaults:ControllerSettings (required);
}

table PoseCapabilities {
  sources:[PoseSource] (required);
  sample_rates_hz:[float] (required);
  base_space_ids:[ulong] (required);
  target_times:[TargetTime] (required);
  defaults:PoseSettings (required);
}

table BodyCapabilities {
  sources:[BodySource] (required);
  sample_rates_hz:[float] (required);
  base_space_ids:[ulong] (required);
  target_times:[TargetTime] (required);
  defaults:BodySettings (required);
}

table Limits {
  min_send_rate_hz:float;
  max_send_rate_hz:float;
  max_history_length:uint;
  max_tracking_message_bytes:uint;
  max_control_message_bytes:uint;
  max_streams_per_client:uint;
}

table Capabilities {
  revision:ulong;
  controller:ControllerCapabilities;
  pose:PoseCapabilities;
  body:BodyCapabilities;
  reference_spaces:[ReferenceSpaceDefinition] (required);
  publication_defaults:PublicationSettings (required);
  limits:Limits (required);
}

// Hello layouts are stable across versions so peers can decode them before negotiation.
table ClientHello {
  request_id:ulong;
  supported_versions:[uint] (required);
}

table ServerHello {
  request_id:ulong;
  // Zero rejects negotiation; reason is then required by the protocol.
  selected_version:uint;
  supported_versions:[uint] (required);
  reason:string;
  // Present on acceptance; with selected_version, fixes context for both channels.
  server_session_id:SessionId;
}

// stream_id = 0 creates a stream; otherwise replace its whole acquisition
// configuration. Unavailable optional selections are listed in StreamAccepted.
table Subscribe {
  request_id:ulong;
  stream_id:ulong;
  acquisition:Acquisition (required);
  publication:PublicationSettings;
}

table UpdatePublication {
  request_id:ulong;
  stream_id:ulong;
  publication:PublicationSettings (required);
}

table Unsubscribe { request_id:ulong; stream_id:ulong; }

table SubscriptionDescriptor {
  subscription_id:ulong;
  acquisition:Acquisition (required);
  // Controller definitions or pose definitions in exactly the sample order.
  inputs:[InputDefinition];
  pose_sources:[PoseSource];
  initial_reference_space:MetadataRef;
  initial_skeleton:MetadataRef;
}

table Omission {
  source_id:string (required);
  // Input ID, or "velocities", "actual_fidelity", "calibration_status",
  // or "source" for an entirely omitted pose source.
  capability_id:string (required);
  reason:string (required);
}

table StreamAccepted {
  // Zero denotes a server-initiated association/publication notification.
  request_id:ulong;
  stream_id:ulong;
  descriptor:SubscriptionDescriptor (required);
  publication:PublicationSettings (required);
  omissions:[Omission] (required);
}

table Alternative {
  acquisition:Acquisition;
  publication:PublicationSettings;
}

table RequestRejected {
  request_id:ulong;
  code:RejectionCode;
  reason:string (required);
  alternatives:[Alternative] (required);
}

table StreamClosed {
  request_id:ulong;
  stream_id:ulong;
  reason:CloseReason;
  detail:string;
}

table SubscriptionRetired { subscription_id:ulong; }

table ReferenceSpaceDefinition {
  reference:MetadataRef (required);
  kind:ReferenceSpaceKind;
  // Null if the runtime cannot provide a valid converted change time.
  effective_at:long = null;
  previous:MetadataRef;
  // New origin expressed in the previous space; absent if unknown.
  pose_in_previous:Transform;
}

table SkeletonJoint {
  joint_id:uint;
  parent_id:int = -1;
  name:string (required);
  // T-pose in SkeletonDefinition.reference_space, not parent-relative.
  rest_pose:Transform (required);
}

table SkeletonDefinition {
  reference:MetadataRef (required);
  joint_set:string (required);
  reference_space:MetadataRef (required);
  // The order is also the order of BodySample.joints.
  joints:[SkeletonJoint] (required);
}

table ServerResumed { resumed_at:long; }

table BooleanValue { value:bool; press_count:ulong; release_count:ulong; }
table ScalarValue { value:float; }
table Vector2Value { value:Vec2 (required); }
union InputValue { BooleanValue = 1, ScalarValue = 2, Vector2Value = 3 }

table ControllerValue {
  is_active:bool;
  last_change_at:long = null;
  value:InputValue (required);
}

table ControllerSample {
  sample_number:ulong;
  acquired_at:long;
  // One entry per descriptor input, including inactive inputs.
  values:[ControllerValue] (required);
}

table Velocity {
  linear:Vec3 (required);
  angular:Vec3 (required);
  flags:VelocityFlags = 0;
}

table PoseValue {
  location:JointPose (required);
  // Null when the source API does not expose activity.
  is_active:bool = null;
  velocity:Velocity;
}

table PoseSample {
  sample_number:ulong;
  acquired_at:long;
  target_at:long = null;
  reference_space:MetadataRef (required);
  poses:[PoseValue] (required);
}

table BodySample {
  sample_number:ulong;
  acquired_at:long;
  target_at:long = null;
  returned_at:long = null;
  reference_space:MetadataRef (required);
  skeleton:MetadataRef (required);
  is_active:bool;
  confidence:float = null;
  actual_fidelity:Fidelity = null;
  calibration_status:CalibrationStatus = null;
  joints:[JointPose] (required);
}

// Nonempty, consecutive acquisition history, oldest to newest. The union keeps
// all samples in a publication the same kind without per-sample type tags.
table ControllerSamples { samples:[ControllerSample] (required); }
table PoseSamples { samples:[PoseSample] (required); }
table BodySamples { samples:[BodySample] (required); }
union Samples { ControllerSamples = 1, PoseSamples = 2, BodySamples = 3 }

table Tracking {
  stream_id:ulong;
  subscription_id:ulong;
  message_number:ulong;
  history:Samples (required);
}

// t1 stays at the client; probes do not use tracking counters or history.
table ClockProbe { request_id:ulong; }
table ClockReply { request_id:ulong; received_at:long; sent_at:long; }

union Message {
  ClientHello = 1,
  ServerHello = 2,
  Capabilities = 3,
  Subscribe = 4,
  UpdatePublication = 5,
  Unsubscribe = 6,
  StreamAccepted = 7,
  RequestRejected = 8,
  StreamClosed = 9,
  SubscriptionRetired = 10,
  ReferenceSpaceDefinition = 11,
  SkeletonDefinition = 12,
  ServerResumed = 13,
  Tracking = 14,
  ClockProbe = 15,
  ClockReply = 16
}

table Packet {
  // ServerHello establishes version and server session for subsequent messages.
  message:Message (required);
}

root_type Packet;
file_identifier "XROP";
file_extension "xrop";
