<resources>
    <style name="OperatorTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#3858AF</item>
        <item name="android:windowBackground">#F7F8FC</item>
        <item name="android:statusBarColor">#F7F8FC</item>
        <item name="android:navigationBarColor">#F7F8FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="SettingsIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">#515D74</item>
    </style>
    <style name="SectionLabel">
        <item name="android:textColor">#525B70</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAction" parent="@android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#354F96</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
