<resources>
    <style name="OperatorTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#3858AF</item>
        <item name="android:windowBackground">#F7F8FC</item>
        <item name="android:statusBarColor">#F7F8FC</item>
        <item name="android:navigationBarColor">#F7F8FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="SectionLabel">
        <item name="android:textColor">#525B70</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAction" parent="@android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#354F96</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="HandChoice" parent="@android:style/Widget.Material.Light.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/hand_text</item>
        <item name="android:background">@drawable/hand_segment</item>
        <item name="android:saveEnabled">false</item>
    </style>
</resources>
