<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_panel" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layout_gravity="end" android:background="#F7F8FC" android:fillViewport="true"
    android:accessibilityPaneTitle="@string/settings" android:clickable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="20dp" android:paddingVertical="16dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/settings" android:textSize="24sp" android:textColor="#1E283F"
                android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" />
            <ImageButton android:id="@+id/close_settings" style="@style/SettingsIcon"
                android:src="@drawable/close" android:contentDescription="@string/close_settings"
                android:tooltipText="@string/close_settings" />
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/operator_address" />
        <TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="18sp" android:fontFamily="monospace"
            android:textColor="#26344F" android:textIsSelectable="true" />

        <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/tracking_source" android:labelFor="@id/source" />
        <Spinner android:id="@+id/source" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:entries="@array/sources" android:saveEnabled="false" />
        <TextView android:id="@+id/source_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="#26344F" />
        <TextView android:id="@+id/hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="15sp" android:textColor="#515D74" />
        <Button android:id="@+id/retry" style="@style/TextAction" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/retry" android:visibility="gone" />
        <Button android:id="@+id/recenter" style="@style/TextAction" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/recenter" />
    </LinearLayout>
</ScrollView>
