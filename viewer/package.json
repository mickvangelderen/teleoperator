{
  "name": "xr-operator-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate": "node tools/generate.mjs",
    "dev": "pnpm generate && vite --host 127.0.0.1",
    "build": "pnpm generate && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm generate && tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:tracking": "node tests/tracking.mjs"
  },
  "dependencies": {
    "flatbuffers": "25.9.23"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
